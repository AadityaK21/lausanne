# virtualenvs
.venv/
venv/
env/

# python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# run artefacts — these contain transcripts and notes derived from real audio
# and must never be committed
work/
output/
results/

# audio and gold corpora are downloaded, not vendored
data/audio/*
!data/audio/.gitkeep
data/gold/*
!data/gold/.gitkeep
*.mp3
*.wav
*.m4a
*.ogg
*.flac

# secrets
.env
*.token

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db

# quarantined run artefacts. Same reason as work/ and output/ above: these are
# transcripts and notes derived from real recordings. The folder name is not a
# licence to commit them.
_to_delete/

# the survey draft this work implements. Unpublished; cited in the docs but
# not vendored, because a public repo is indexed and archived and a PDF is
# hard to un-publish.
docs/legal_ai_survey_paper.pdf
